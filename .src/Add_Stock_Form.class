' Gambas class file


Public Sub FileChooser1_Activate()

  
  

End

Public Sub Form_Show()
  FileChooser1.Root = User.Home & "/Pictures"
  FileChooser1.View = FileView.Preview
  FileChooser1.Refresh
  Print "Form Show"
End

Public Sub FileChooser1_Change()

Print FileChooser1.SelectedPath
  If Exist(FileChooser1.SelectedPath) 
    PictureBox1.Picture = Picture.Load(FileChooser1.SelectedPath)
  Endif 
End

Public Sub Button1_Click()

  Dim res As Result
  
  res = Global.DBConn.Create("products")
  res!barcode = TextBox2.Text
  res!partnum = TextBox1.Text
  res!image = Global.Convert_pic_to_blob(PictureBox1.Picture)
  res!amount = SliderBox1.Value
  res!date = Now
  res!description = TextBox2.Text
  res!price = 0
  res!category = 1
  res!brand = 1
  
  res.Update
  Global.DBConn.Commit
  
End

Public Sub Form_Open()

  TextBox2.SetFocus

End
