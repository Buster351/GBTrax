Public Sub DataSource1_Change()
  
  Dim tmp As New Variant[]
  Dim res As Result
  
  If DataSource1.Current <> Null Then
    tmp = DataSource1.Current
    Print "data change" & " ID= " & Str(tmp[0])
    res = Global.DBConn.Find("products", "id = &1", Str(tmp[0]))
    
      PictureBox1.Picture = Global.Get_scaled_picture_from_Blob(res!image, PictureBox1.w, PictureBox1.H)
    
  Endif 
  

End
